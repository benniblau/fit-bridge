# fit-bridge — COROS → Garmin
#
#   python bridge.py --config coros.env
#
# Copy to coros.env and fill in. *.env is gitignored; this repo is public.

BRIDGE_SOURCE=coros

# --- Safety -----------------------------------------------------------------
# The pause switch. While false every scheduled run is a no-op, so cron can be
# installed before the bridge is trusted.
BRIDGE_ENABLED=false

# Hard floor, YYYY-MM-DD. Nothing recorded before this day is ever uploaded.
# Set it to the day the COROS watch became the only watch; without it the
# bridge could push years of imported Garmin history back into Garmin.
BRIDGE_START_DATE=2026-08-20

BRIDGE_MAX_PER_RUN=10
BRIDGE_MAX_ATTEMPTS=3
BRIDGE_LOOKBACK_DAYS=2
BRIDGE_SLEEP_BETWEEN=2

# Canonical sports never to upload, comma separated. One of: running, cycling,
# swimming, walking, gym, snow, water, climb, other.
BRIDGE_SKIP_SPORTS=

# --- Device identity written into every upload ------------------------------
# 1 = garmin. The default device is what everything is attributed to unless a
# BRIDGE_DEVICE_<SPORT> override matches; COROS activities here are all runs,
# so one device is enough.
BRIDGE_MANUFACTURER_ID=1
BRIDGE_PRODUCT_ID=4536
BRIDGE_GARMIN_SERIAL=

# --- State ------------------------------------------------------------------
# Defaults to <source>.db, so two bridges in one directory cannot share a
# ledger and lose each other's activities to a primary-key collision.
BRIDGE_DB_PATH=coros.db

# --- Services (shared by every bridge) ---------------------------------------
# Three of the four hops are HTTP calls to services on this machine. This repo
# holds no FIT editor, no upstream API logic and no Garmin session.
BRIDGE_CONVERTER_URL=http://127.0.0.1:7077

# Where the MCP services live. Each bridge's source URL is assembled from
# MCP_HOST plus that source's own port variable.
MCP_HOST=127.0.0.1
COROS_MCP_PORT=8086
ZWIFT_MCP_PORT=8087
GARMIN_MCP_PORT=8080

# Bearer tokens, matching each service's own .env. These are not COROS, Zwift
# or Garmin credentials: they authorise this bridge to those services and
# nothing else.
COROS_MCP_AUTH_TOKEN=
ZWIFT_MCP_AUTH_TOKEN=
GARMIN_MCP_AUTH_TOKEN=
