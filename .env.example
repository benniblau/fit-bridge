# coros-garmin-bridge configuration
#
# Copy to .env and fill in. .env is gitignored — this repo is public.

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------

# The pause switch. While false, every scheduled run is a no-op, so cron can be
# installed now and the bridge switched on later by flipping this one value.
# Only `--dry-run`, `--status` and `--only <id> --force` do anything while it
# is false.
BRIDGE_ENABLED=false

# Hard floor, YYYY-MM-DD. Nothing recorded before this day is ever uploaded.
# Set it to the day the COROS watch became the only watch. Required.
BRIDGE_START_DATE=2026-08-20

# Upper bound on activities processed per run. Bounds the blast radius of a bug.
BRIDGE_MAX_PER_RUN=10

# How often a failed activity is retried before it is left alone for inspection.
BRIDGE_MAX_ATTEMPTS=3

# Days of overlap added to each run's query window, so activities that reach
# COROS late are still picked up.
BRIDGE_LOOKBACK_DAYS=2

# COROS sport type ids never to upload, comma separated. Empty means upload
# everything. (100 run, 200 road bike, 300 pool swim, 402 strength, 900 walk —
# see coros-mcp/schema/schema_coros.sql for the full table.)
BRIDGE_SKIP_SPORTS=

# Seconds to wait between activities.
BRIDGE_SLEEP_BETWEEN=2

# ---------------------------------------------------------------------------
# Device identity written into every uploaded file
# ---------------------------------------------------------------------------

# 1 = garmin, 4536 = fenix_8.
BRIDGE_MANUFACTURER_ID=1
BRIDGE_PRODUCT_ID=4536

# The serial of the Garmin device you actually own, so Garmin sees a device
# registered to the account. This is the part the whole premise rests on.
# Find it in Garmin Connect under the device's settings, or read the
# serial_number field of file_id in any FIT file that device recorded.
BRIDGE_GARMIN_SERIAL=

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
#
# Three of the four hops are HTTP calls to services already running on this
# machine. The bridge carries no FIT editor, no COROS export logic and no
# Garmin session of its own.

# fit-manager, which rewrites the recording device. Only /api/v1 is used.
BRIDGE_CONVERTER_URL=http://127.0.0.1:7077

# Only needed if the conversion service sets FIT_API_KEY.
#BRIDGE_CONVERTER_API_KEY=

# coros-mcp and garmin-mcp. Both are normally left unset: the addresses are
# assembled from MCP_HOST plus each service's own port variable below, which
# the sibling projects already define. Set these only to override that.
#BRIDGE_COROS_API_URL=http://10.10.1.224:8086
#BRIDGE_GARMIN_API_URL=http://10.10.1.224:8080

# Where the two servers live. MCP_HOST defaults to 127.0.0.1 and both ports
# default to 8080, which is each project's own default.
MCP_HOST=127.0.0.1
COROS_MCP_PORT=8086
GARMIN_MCP_PORT=8080

# Bearer tokens for those two APIs. They must match COROS_MCP_AUTH_TOKEN and
# GARMIN_MCP_AUTH_TOKEN in the respective checkouts — which is why the plain
# names are accepted as a fallback, so one .env can carry a single copy.
COROS_MCP_AUTH_TOKEN=
GARMIN_MCP_AUTH_TOKEN=
#BRIDGE_COROS_API_TOKEN=
#BRIDGE_GARMIN_API_TOKEN=

# State database.
BRIDGE_DB_PATH=bridge.db

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# There are none, deliberately. Every hop is an HTTP call to a service on this
# machine: coros-mcp holds the COROS login and its shared token cache,
# garmin-mcp holds the garth session. The only secrets here are the two bearer
# tokens above, which authorise this bridge to those two services and nothing
# else — neither is a COROS or Garmin credential, and neither grants access to
# either account directly.
