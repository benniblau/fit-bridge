[Unit]
# Optional alternative to the cron entry in README.md — use one or the other,
# not both. Pair with coros-garmin-bridge.timer, which does the scheduling.
Description=COROS to Garmin activity bridge (one run)
After=network-online.target fit-file-manager.service
Wants=network-online.target

[Service]
Type=oneshot
User=benni
Group=benni
WorkingDirectory=/home/benni/coros-garmin-bridge
ExecStart=/home/benni/coros-garmin-bridge/.venv/bin/python bridge.py
EnvironmentFile=/home/benni/coros-garmin-bridge/.env
StandardOutput=journal
StandardError=journal

# Security hardening. ProtectHome is deliberately NOT set: this unit runs from
# /home/benni and would not be able to see its own working directory, its
# state database, or the sibling checkouts it imports from.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
