# fit-bridge — Zwift → Garmin
#
#   python bridge.py --config zwift.env
#
# Copy to zwift.env and fill in. *.env is gitignored; this repo is public.

BRIDGE_SOURCE=zwift

# --- Safety -----------------------------------------------------------------
BRIDGE_ENABLED=false

# Hard floor. Zwift holds years of history; without a floor set to roughly
# "now", the first run would upload all of it into Garmin at once.
BRIDGE_START_DATE=2026-08-28

BRIDGE_MAX_PER_RUN=10
BRIDGE_MAX_ATTEMPTS=3
BRIDGE_LOOKBACK_DAYS=2
BRIDGE_SLEEP_BETWEEN=2

BRIDGE_SKIP_SPORTS=

# --- Device identity written into every upload ------------------------------
# Zwift records both rides and runs, and the device has to match the activity:
# a run attributed to a bike computer is incoherent, and Garmin can be expected
# to discard or mis-file it. So the default is the watch and cycling overrides
# to the Edge. Format is product_id:serial_number.
BRIDGE_MANUFACTURER_ID=1

# fenix 8 — the default, and what Zwift runs are attributed to.
BRIDGE_PRODUCT_ID=4536
BRIDGE_GARMIN_SERIAL=

# Edge 1030 (product 2713), for rides. Both devices must be registered to the
# Garmin account or the upload is attributed to nothing.
BRIDGE_DEVICE_CYCLING=2713:

# --- State ------------------------------------------------------------------
BRIDGE_DB_PATH=zwift.db

# --- Services (shared by every bridge) ---------------------------------------
# Three of the four hops are HTTP calls to services on this machine. This repo
# holds no FIT editor, no upstream API logic and no Garmin session.
BRIDGE_CONVERTER_URL=http://127.0.0.1:7077

# Where the MCP services live. Each bridge's source URL is assembled from
# MCP_HOST plus that source's own port variable.
MCP_HOST=127.0.0.1
COROS_MCP_PORT=8086
ZWIFT_MCP_PORT=8087
GARMIN_MCP_PORT=8080

# Bearer tokens, matching each service's own .env. These are not COROS, Zwift
# or Garmin credentials: they authorise this bridge to those services and
# nothing else.
COROS_MCP_AUTH_TOKEN=
ZWIFT_MCP_AUTH_TOKEN=
GARMIN_MCP_AUTH_TOKEN=
