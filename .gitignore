# Credentials and secrets. One config file per bridge now, so the pattern has
# to cover coros.env and zwift.env too — but not the *.env.example templates.
.env
*.env
!*.env.example

# Session tokens
.coros_token.json
.garth/

# State database
*.db
*.db-shm
*.db-wal

# Activity files — personal training data, never commit
*.fit
*.tcx
*.gpx
*.zip
work/
exports/

# Logs and run state
*.log

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/
